# Copy to deploy/demo/.env (gitignored) on the host that runs the public demo.

# Token of the Cloudflare Tunnel whose public hostname points at http://app:8001.
DEMO_TUNNEL_TOKEN=

# Admin login for the demo dashboard. Nobody needs it day to day — make it
# long and random:  openssl rand -base64 24
DEMO_ADMIN_PASSWORD=

# The account reviewers sign in with. Do not reuse the seed script's default
# password (it is in the public repo); share this one only in review notes.
DEMO_ATHLETE_USERNAME=sofia
DEMO_ATHLETE_PASSWORD=

# Host port the API is bound to on 127.0.0.1 (seeding + local health checks).
DEMO_API_PORT=8011
