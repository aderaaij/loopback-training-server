# Only needed when running the MCP on its own (see README "MCP Server").
# The Docker image serves the MCP at /mcp with no configuration.

TRAINING_API_URL=http://localhost:8001
# A token for the account the MCP acts as when a caller sends no Authorization
# header of their own (stdio clients). Mint one in the dashboard:
# Settings -> Create token.
TRAINING_API_KEY=
LOG_LEVEL=INFO
REQUEST_TIMEOUT=30
